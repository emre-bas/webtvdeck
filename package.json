{
  "name": "webtvdeck",
  "productName": "WebTVDeck",
  "private": true,
  "version": "0.1.1",
  "description": "Full-screen IPTV player PWA for your own M3U playlists",
  "keywords": ["iptv", "iptv-player", "m3u", "m3u8", "hls", "epg", "xmltv", "pwa"],
  "homepage": "https://emre-bas.github.io/webtvdeck/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emre-bas/webtvdeck.git"
  },
  "bugs": {
    "url": "https://github.com/emre-bas/webtvdeck/issues"
  },
  "license": "MIT",
  "author": "Emre Baş (https://github.com/emre-bas)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/serve.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "oxlint"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "hls.js": "^1.7.3",
    "idb": "^8.0.3",
    "lucide-react": "^1.49.0",
    "mpegts.js": "^1.8.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.86.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
